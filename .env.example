# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Cloudflare Turnstile. These defaults are Cloudflare's official test keys (always pass);
# replace them with real keys from the Cloudflare dashboard before going public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Any long random string, used to hash IPs for rate limiting (generate: openssl rand -hex 32)
IP_HASH_SALT=change-me

# Sentry error monitoring (optional; leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time token for uploading source maps (Sentry → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
